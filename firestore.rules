rules_version = '2';

service cloud.firestore {
  // 관리자 권한 확인 함수
  function isAdmin() {
  // ✅ 안전: 오직 set-admin-claim.js로 권한을 받은 계정만 통과
  return request.auth != null && request.auth.token.admin == true;
  }

  function canAuditAllstarVotes() {
    return request.auth != null
      && request.auth.token.admin == true
      && request.auth.token.allstarVoteAuditor == true;
  }

  function coachRoleDoc() {
    return get(/databases/(default)/documents/roles/$(request.auth.uid));
  }

  function isScorer() {
    return request.auth != null
      && coachRoleDoc().data.role == 'scorer';
  }

  function isScorerMatchUpdate() {
    return isScorer()
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'homeScore',
        'awayScore',
        'lineups',
        'benches',
        'postGame',
        'manualEntryDraft',
        'scoreInputMode',
        'status',
        'lineupPublic',
        'liveVideoUrl',
        'liveDelaySeconds',
        'updatedAt',
      ]);
  }

  function isCoachOfTeam(teamId) {
    return request.auth != null
      && coachRoleDoc().data.role == 'coach'
      && coachRoleDoc().data.teamId == teamId;
  }

  function isCoachRole() {
    return request.auth != null
      && coachRoleDoc().data.role == 'coach';
  }

  function isPlayerOrStaffRole() {
    return request.auth != null
      && coachRoleDoc().data.role in ['player', 'staff'];
  }

  function canReadPlayerRegistrationBoard() {
    return request.auth != null
      && (
        isAdmin()
        || isScorer()
        || isCoachRole()
        || isPlayerOrStaffRole()
      );
  }

  function canWritePlayerRegistrationCategory(category) {
    return (category == '선수 등록' && isAdmin())
      || (category == '유니폼 등록' && (isAdmin() || isCoachRole()));
  }

  function canSelfSyncPlayerOrStaffRole(userId) {
    return request.auth != null
      && request.auth.uid == userId
      && request.resource.data.keys().hasOnly([
        'uid',
        'role',
        'teamId',
        'teamName',
        'syncedBy',
        'syncedAt',
      ])
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.role in ['player', 'staff']
      && request.resource.data.teamId is string
      && request.resource.data.teamName is string
      && request.resource.data.syncedBy == 'membership-sync'
      && request.resource.data.syncedAt is int
      && exists(/databases/(default)/documents/teams/$(request.resource.data.teamId)/members/$(request.auth.uid))
      && get(/databases/(default)/documents/teams/$(request.resource.data.teamId)/members/$(request.auth.uid)).data.role == request.resource.data.role
      && (
        !exists(/databases/(default)/documents/roles/$(userId))
        || resource.data.role in ['player', 'staff']
      );
  }

  function isValidPresenceCreate(visitorId) {
    return request.resource.data.keys().hasOnly(['visitorId', 'isAnonymous', 'lastHeartbeat', 'expiresAt'])
      && request.resource.data.visitorId == visitorId
      && request.resource.data.isAnonymous is bool
      && request.resource.data.lastHeartbeat is int
      && request.resource.data.expiresAt is int
      && request.resource.data.expiresAt >= request.resource.data.lastHeartbeat;
  }

  function isValidPresenceUpdate(visitorId) {
    return request.resource.data.visitorId == visitorId
      && request.resource.data.isAnonymous is bool
      && request.resource.data.lastHeartbeat is int
      && request.resource.data.expiresAt is int
      && request.resource.data.expiresAt >= request.resource.data.lastHeartbeat
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visitorId', 'isAnonymous', 'lastHeartbeat', 'expiresAt']);
  }

  match /databases/{database}/documents {
    // 앱 전반 설정 (현재 활성 경기 포인터)
    match /app/current {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 서비스 점검 설정
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 경기 일정
    match /matches/{matchId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isScorerMatchUpdate();
    }

    // [수정됨] 공지사항 및 댓글 규칙
    match /notices/{noticeId} {
      // 공지사항 자체는 누구나 읽기 가능
      allow read: if true;
      // 생성은 관리자만 허용
      allow create: if isAdmin();
      // 수정은 관리자 또는 작성자 본인만 허용 (작성자 uid 변경 불가)
      allow update: if request.auth != null && (
        isAdmin() || (
          request.auth.uid == resource.data.uid
          && request.resource.data.uid == resource.data.uid
        )
      );
      // 삭제는 관리자 또는 작성자 본인만 허용
      allow delete: if request.auth != null && (
        isAdmin() || request.auth.uid == resource.data.uid
      );

      // [추가] 공지사항 하위의 댓글 컬렉션 규칙
      match /comments/{commentId} {
        // 1. 읽기: 누구나 가능 (비로그인 사용자 포함)
        allow read: if true;
        
        // 2. 쓰기(생성): 로그인한 사용자만 가능
        allow create: if request.auth != null;
        
        // 3. 수정/삭제: 관리자이거나, 본인이 작성한 댓글(uid 일치)인 경우만 가능
        allow update, delete: if request.auth != null && (
          isAdmin() || request.auth.uid == resource.data.uid
        );
      }
    }

    // 건의/문의 게시판
    match /inquiries/{inquiryId} {
      // 목록 및 메타데이터는 누구나 읽기 가능 (비밀글 내용 제한은 클라이언트에서 처리)
      allow read: if true;
      // 작성은 로그인한 사용자만
      allow create: if request.auth != null;
      // 수정/삭제는 작성자 또는 관리자만
      allow update, delete: if request.auth != null && (
        isAdmin() || request.auth.uid == resource.data.uid
      );

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && (
          isAdmin() || request.auth.uid == resource.data.uid
        );
      }
    }

    // 선수 등록 게시판
    match /playerRegistrationPosts/{postId} {
      allow read: if canReadPlayerRegistrationBoard();
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.category in ['선수 등록', '유니폼 등록']
        && canWritePlayerRegistrationCategory(request.resource.data.category);
      allow update: if request.auth != null
        && request.resource.data.uid == resource.data.uid
        && (
          isAdmin()
          || (
            request.auth.uid == resource.data.uid
            && request.resource.data.category in ['선수 등록', '유니폼 등록']
            && canWritePlayerRegistrationCategory(request.resource.data.category)
          )
        );
      allow delete: if request.auth != null
        && (
          isAdmin()
          || (
            request.auth.uid == resource.data.uid
            && resource.data.category in ['선수 등록', '유니폼 등록']
            && canWritePlayerRegistrationCategory(resource.data.category)
          )
        );
    }

    // 실시간 경기 상태 (스코어보드/문자중계)
    match /matchStates/{matchId} {
      allow read: if true;
      allow write: if isAdmin() || isScorer();

      match /feed/{entryId} {
        allow read: if true;
        allow write: if isAdmin() || isScorer();
      }
      match /events/{entryId} {
        allow read: if true;
        allow write: if isAdmin() || isScorer();
      }

      match /presence/{visitorId} {
        allow read: if true;
        allow create: if isValidPresenceCreate(visitorId);
        allow update: if isValidPresenceUpdate(visitorId);
        allow delete: if true;
      }
    }

    // 랜딩/인트로 콘텐츠 (공개 읽기, 관리자 편집)
    match /settings/content {
      allow read: if true;
      allow write: if isAdmin();
    }

    // LIVE INFO (실시간)
    match /settings/liveInfo {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 정적 콘텐츠 + 버전 메타
    match /settings/staticContent {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/contentMeta {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 사용자 프로필 (이메일 매핑용)
    match /users/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // 팀 권한 (감독 지정)
    match /roles/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if isAdmin() || canSelfSyncPlayerOrStaffRole(userId);
    }

    // UGC 신고함 (운영자 검토 대상)
    match /contentReports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.action in ['report', 'block']
        && request.resource.data.reasonType is string
        && request.resource.data.targetUid is string
        && request.resource.data.targetLabel is string
        && request.resource.data.contentDomain is string
        && request.resource.data.contentId is string
        && request.resource.data.contentPreview is string
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is int;
      allow read: if isAdmin() || (
        request.auth != null
        && request.auth.uid == resource.data.reporterUid
      );
      allow update, delete: if isAdmin();
    }

    // 사용자별 차단 목록
    match /userModeration/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /blockedUsers/{blockedUserId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 팀 정보 및 팀원
    match /teams/{teamId} {
      allow read: if true;
      allow write: if isAdmin() || isCoachOfTeam(teamId);

      match /members/{memberId} {
        allow read: if true;
        allow write: if isAdmin() || isCoachOfTeam(teamId);
      }

      match /notices/{noticeId} {
        allow read: if true;
        allow write: if isAdmin() || isCoachOfTeam(teamId);

        match /comments/{commentId} {
          allow read: if true;
          allow create: if request.auth != null;
          allow update, delete: if request.auth != null && (
            isAdmin() || isCoachOfTeam(teamId) || request.auth.uid == resource.data.uid
          );
        }
      }
    }

    // 컬렉션 그룹(members) 조회 허용
    match /{path=**}/members/{memberId} {
      allow read: if true;
    }

    // 올스타/루키 투표 데이터. 일반 클라이언트는 callable Functions만 사용한다.
    // 후보 설정은 관리자, 비공개 결과는 별도 감사 claim 계정만 직접 읽을 수 있다.
    match /allstarVotingEvents/{eventId} {
      allow read, write: if isAdmin();

      match /candidateSets/{candidateSetId} {
        allow read, create: if isAdmin();
        // published 후보 세트는 일반 관리자 도구에서도 불변이다. 수정 시 새 ID를 만든다.
        allow update, delete: if isAdmin() && resource.data.published != true;
      }

      // 첫 정상 투표와 같은 transaction에서 한 번만 생성되는 설정 잠금.
      // 이후 제출은 읽기만 하며 클라이언트는 조회하거나 변경할 수 없다.
      match /configLocks/{divisionId} {
        allow read, write: if false;
      }

      match /ballots/{ballotId} {
        allow read: if canAuditAllstarVotes();
        allow write: if false;
      }

      match /voterEligibility/{eligibilityId} {
        allow read: if canAuditAllstarVotes();
        allow write: if false;
      }

      // 공개 callable이 반환할 후보별 합계 원본. 일반 클라이언트 직접 읽기는 금지한다.
      match /publicResults/{divisionId} {
        allow read: if isAdmin();
        // 결과는 CLOSED 원장을 검증하는 Admin SDK callable만 생성·변경한다.
        allow write: if false;
      }

      // 원본 전체 검사에서 만들어진 비공개 결과 초안. 클라이언트 접근 금지.
      match /resultDrafts/{divisionId} {
        allow read, write: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    // 그 외 모든 접근 거부
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
