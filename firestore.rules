rules_version = '2';

service cloud.firestore {
  function isAdmin() {
    return request.auth != null
      && (request.auth.token.admin == true
        || request.auth.token.email in ['aublcau@gmail.com', 'aublcauadmin@aubl.club', 'jhyoon01677002@gmail.com', 'synapse9983@gmail.com', 'example@ecam.com']);
  }

  match /databases/{database}/documents {
    // App-wide metadata (currently just the active match pointer)
    match /app/current {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public schedule
    match /matches/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Live match state (scoreboard / 문자중계 데이터)
    match /matchStates/{matchId} {
      allow read: if true;
      allow write: if isAdmin();

      // 최근 feed/events 서브컬렉션
      match /feed/{entryId} {
        allow read: if true;
        allow write: if isAdmin();
      }
      match /events/{entryId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Deny anything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
