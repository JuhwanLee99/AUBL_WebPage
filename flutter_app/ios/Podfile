platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  warning_suppressed_targets = {
    'sign_in_with_apple' => ['SWIFT_SUPPRESS_WARNINGS', 'YES'],
    'flutter_local_notifications' => ['GCC_WARN_INHIBIT_ALL_WARNINGS', 'YES'],
  }

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      # Pods warnings are noisy and not actionable in app code.
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'

      # Remove duplicated linker flags (ex: -lc++) that trigger noisy warnings.
      if config.build_settings['OTHER_LDFLAGS'].is_a?(Array)
        filtered_ldflags = config.build_settings['OTHER_LDFLAGS'].reject do |flag|
          ['-lc++', '-l"c++"'].include?(flag)
        end
        config.build_settings['OTHER_LDFLAGS'] = filtered_ldflags.uniq
      end

      if warning_suppressed_targets.key?(target.name)
        key, value = warning_suppressed_targets[target.name]
        config.build_settings[key] = value
      end
    end

    # Avoid Xcode warning for scripts without outputs.
    target.shell_script_build_phases.each do |phase|
      next unless phase.name == 'Create Symlinks to Header Folders'

      if phase.output_paths.nil? || phase.output_paths.empty?
        phase.output_paths = [
          "${DERIVED_FILE_DIR}/#{target.name}_headers_symlink.stamp",
        ]
      end

      next if phase.shell_script.include?('SCRIPT_OUTPUT_FILE_0')

      phase.shell_script = <<~SCRIPT
        #{phase.shell_script}
        /usr/bin/touch "${SCRIPT_OUTPUT_FILE_0}"
      SCRIPT
    end
  end

  # CocoaPods writes -l"c++" into generated xcconfig files for many pods.
  # clang++ already links libc++, so strip explicit flags to avoid duplicate-lib warnings.
  target_support_dir = File.join(__dir__, 'Pods', 'Target Support Files')
  Dir.glob(File.join(target_support_dir, '**', '*.xcconfig')).each do |path|
    original = File.read(path)
    updated = original.gsub(' -l"c++"', '').gsub(' -lc++', '')
    next if original == updated

    File.open(path, 'w') { |file| file.write(updated) }
  end
end
