{
  "name": "aubl-website",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "emulator": "firebase emulators:start --only firestore",
    "emulator:save": "firebase emulators:export ./firestore-local",
    "emulator:import": "firebase emulators:start --only firestore --import ./firestore-local",
    "build": "vite build && node scripts/generate-og-pages.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:ci": "npm run lint && npm run build"
  },
  "dependencies": {
    "dompurify": "^3.3.1",
    "firebase": "^11.10.0",
    "firebase-admin": "^12.7.0",
    "gsap": "^3.12.5",
    "html2canvas": "^1.4.1",
    "quill": "^2.0.3",
    "quill-delta-to-html": "^0.12.1",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.6",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.2.2"
  },
  "overrides": {
    "fast-xml-parser": "^5.3.4"
  }
}
