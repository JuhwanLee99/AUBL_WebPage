VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_ADMIN_EMAILS=admin1@example.com,admin2@example.com #관리자 계정 이메일
VITE_BACKEND_API_URL=https://api.aubl.club
# Vite dev proxy target (원격 전용 사용 시 API URL과 동일하게 설정)
VITE_BACKEND_PROXY_TARGET=https://api.aubl.club
# 로컬 테스트 백엔드가 없으면 비워두세요.
VITE_BACKEND_TEST_URL=
# 기본 false: dev proxy가 Origin/Referer를 제거해 CORS 403을 피합니다.
# true가 필요한 백엔드에서만 명시적으로 켜세요.
VITE_BACKEND_PROXY_SPOOF_ORIGIN=false
# 자체 서명 인증서 HTTPS 백엔드는 false (기본 true)
VITE_BACKEND_PROXY_SECURE=true

# 올스타/루키 투표 callable API. Functions와 비공개 이벤트 설정 검증 전에는 false 유지.
# 올스타 OG/공유 메타 페이지는 실제 공개 배포에서만 생성합니다.
ALLSTAR_STATIC_PAGES_ENABLED=false
# 로컬 UI 검수용 익명 후보 카드. 운영 빌드에서는 반드시 false 유지.
VITE_ALLSTAR_SHOW_DRAFT_CANDIDATES=false
# Firebase Console에서 웹 앱을 reCAPTCHA Enterprise App Check에 등록한 뒤 공개 site key 입력.
# 키가 없으면 App Check 클라이언트를 초기화하지 않습니다.
VITE_FIREBASE_APPCHECK_SITE_KEY=
