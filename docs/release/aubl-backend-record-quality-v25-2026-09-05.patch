+        assertEquals(0, review.path("originalDetail").path("teams").get(0).path("batters").get(0).path("stats").path("runs").asInt());
+        var repeated = UniquePlayDetailCorrections.effective(raw, first, List.of(), M);
+        assertEquals(1, batter(repeated).path("runs").asInt());
