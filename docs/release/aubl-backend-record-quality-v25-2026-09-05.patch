+        var fixedSource = clean();
+        var resolved = UniquePlayDetailCorrections.effective(fixedSource, published, List.of(), M);
+        assertEquals("SOURCE_RESOLVED", review(resolved).path("corrections").get(0).path("status").asText());
+        assertEquals("SOURCE", review(resolved).path("resolutionSource").asText());
+        assertTrue(review(resolved).path("notifications").toString().contains("SOURCE_RESOLVED"));
+        batter(fixedSource).put("runs", 2);
+        var later = UniquePlayDetailCorrections.effective(fixedSource, resolved, List.of(), M);
+        assertEquals(2, batter(later).path("runs").asInt()); assertEquals("RETIRED", review(later).path("corrections").get(0).path("status").asText());
+    }
+    @Test void changedSourceAndPlayerIdentityBecomeBlockingCorrectionConflicts() {
+        var raw = clean(); batter(raw).put("runs", 0);
+        var published = UniquePlayDetailCorrections.effective(raw, null, List.of(correction(raw, "runs", 0, 1)), M);
+        batter(raw).put("runs", 2);
+        var changed = UniquePlayDetailCorrections.effective(raw, published, List.of(), M);
+        assertEquals(2, batter(changed).path("runs").asInt()); assertEquals("CONFLICT", review(changed).path("corrections").get(0).path("status").asText());
+        batter(raw).put("runs", 0); ((ObjectNode) raw.path("gameDetails").get(0).path("teams").get(0).path("batters").get(0)).put("playerName", "다른선수");
+        var other = UniquePlayDetailCorrections.effective(raw, published, List.of(), M);
+        assertEquals("CONFLICT", review(other).path("corrections").get(0).path("status").asText()); assertEquals(0, batter(other).path("runs").asInt());
+    }
