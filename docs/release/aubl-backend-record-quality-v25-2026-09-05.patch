diff --git a/src/main/java/com/aubl/webpage/service/UniquePlayDetailCorrections.java b/src/main/java/com/aubl/webpage/service/UniquePlayDetailCorrections.java
--- /dev/null
+++ b/src/main/java/com/aubl/webpage/service/UniquePlayDetailCorrections.java
@@ -0,0 +1,211 @@
+package com.aubl.webpage.service;
+
+import com.aubl.webpage.api.dto.UniquePlaySyncDtos.DetailChange;
+import com.aubl.webpage.domain.entity.UniquePlaySyncItem;
+import java.time.OffsetDateTime;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Set;
+import java.util.UUID;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.server.ResponseStatusException;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.ObjectMapper;
+import tools.jackson.databind.node.ArrayNode;
+import tools.jackson.databind.node.ObjectNode;
+
+/** Server-owned audit metadata. Never accepted from a worker or exposed by public detail endpoints. */
+final class UniquePlayDetailCorrections {
+    static final String META = "detailReview";
+    static final String ENTITY = "GAME_CORRECTION";
+    private static final Set<String> BATTER_FIELDS = Set.of("atBats", "hits", "rbi", "stolenBases", "runs", "battingAverage", "seasonBattingAverage");
+    private static final Set<String> PITCHER_FIELDS = Set.of("outs", "inningsPitched", "hitsAllowed", "runsAllowed", "earnedRuns", "walksAndHitByPitch", "strikeouts", "era");
+    private UniquePlayDetailCorrections() {}
+
+    static JsonNode effective(JsonNode candidate, JsonNode base, List<UniquePlaySyncItem> items, ObjectMapper mapper) {
+        if (!candidate.has("gameDetails")) return candidate;
+        JsonNode chosen = UniquePlayGameDetailSupport.resolvedCandidate(candidate, items, mapper);
+        ObjectNode result = ((ObjectNode) chosen).deepCopy();
+        result.remove(META);
+        ArrayNode metadata = result.putObject(META).putArray("games");
+        Set<String> present = new HashSet<>();
+        for (JsonNode source : chosen.path("gameDetails")) {
+            String sourceId = source.path("sourceGameId").asText();
+            present.add(sourceId);
+            ObjectNode detail = (ObjectNode) UniquePlayGameDetailSupport.index(result.path("gameDetails")).get(sourceId);
+            JsonNode previous = reviewGame(base, sourceId);
+            boolean retainedDetail = items.stream().anyMatch(item -> "GAME_RECORD".equals(item.getEntityType())
+                && sourceId.equals(item.getSourceKey()) && "KEEP_AUBL".equals(item.getResolution()));
+            if (retainedDetail && previous.path("originalDetail").isObject()) {
+                // Keeping a previously corrected official detail is not evidence that UniquePlay fixed its raw value.
+                source = previous.path("originalDetail");
+                detail.removeAll(); detail.setAll((ObjectNode) source.deepCopy());
+            }
+            LinkedHashMap<String, JsonNode> patches = new LinkedHashMap<>();
+            for (JsonNode patch : previous.path("corrections")) patches.put(targetKey(patch), patch);
+            items.stream().filter(item -> ENTITY.equals(item.getEntityType()) && item.getAfterJson() != null)
+                .sorted(Comparator.comparing(UniquePlaySyncItem::getId, Comparator.nullsLast(Comparator.naturalOrder())))
+                .map(item -> mapper.readTree(item.getAfterJson())).filter(patch -> sourceId.equals(patch.path("sourceGameId").asText()))
+                .forEach(patch -> patches.put(targetKey(patch), patch));
+            ObjectNode review = metadata.addObject();
+            review.put("sourceGameId", sourceId);
+            review.set("originalDetail", source.deepCopy());
+            ArrayNode corrections = review.putArray("corrections"), notifications = review.putArray("notifications");
+            boolean manual = false, newlyResolved = false;
+            boolean available = "AVAILABLE".equals(detail.path("status").asText());
+            for (JsonNode stored : patches.values()) {
+                ObjectNode patch = ((ObjectNode) stored).deepCopy();
+                String oldStatus = stored.path("status").asText();
+                if ("RETIRED".equals(oldStatus)) { corrections.add(patch); continue; }
+                JsonNode container = locate(source, patch, false);
+                JsonNode actual = container == null ? null : container.get(patch.path("field").asText());
+                if ("SOURCE_RESOLVED".equals(oldStatus)) {
+                    // The override has retired. Future source edits are no longer constrained by its old expected value.
+                    if (actual == null || !same(actual, patch.path("value"))) patch.put("status", "RETIRED");
+                } else if (actual != null && same(actual, patch.path("value"))) {
+                    patch.put("status", "SOURCE_RESOLVED");
+                    if (!"SOURCE_RESOLVED".equals(oldStatus)) {
+                        notify(notifications, "SOURCE_RESOLVED", "원천 기록이 관리자 수정값과 같아져 수동 보정을 해제했습니다.", sourceId, patch.path("id").asText());
+                        newlyResolved = true;
+                    }
+                } else if (!"SOURCE_RESOLVED".equals(oldStatus) && actual != null && same(actual, patch.path("expectedValue"))) {
+                    ((ObjectNode) locate(detail, patch, true)).set(patch.path("field").asText(), patch.path("value"));
+                    patch.put("status", "APPLIED"); manual = true;
+                } else {
+                    patch.put("status", "CONFLICT");
+                    notify(notifications, "CORRECTION_CONFLICT", "원천 값 또는 선수 행 식별자가 바뀌었습니다. 수동 보정 유지 여부를 다시 확인하세요.", sourceId, patch.path("id").asText());
+                }
+                corrections.add(patch);
+            }
+            var issues = UniquePlayDetailQuality.issues(detail);
+            review.set("issues", mapper.valueToTree(issues));
+            Set<String> current = new HashSet<>(); issues.forEach(issue -> current.add(issue.id()));
+            Map<String, JsonNode> priorIssues = new LinkedHashMap<>();
+            for (JsonNode oldIssue : previous.path("issues")) priorIssues.put(oldIssue.path("id").asText(), oldIssue);
+            if (manual) for (var oldIssue : UniquePlayDetailQuality.issues(source)) priorIssues.putIfAbsent(oldIssue.id(), mapper.valueToTree(oldIssue));
+            for (JsonNode oldIssue : priorIssues.values()) if (available && !current.contains(oldIssue.path("id").asText())) {
+                notify(notifications, manual ? "MANUAL_RESOLVED" : "SOURCE_RESOLVED", manual ? "관리자 보정으로 기존 검수 경고가 해결되었습니다." : "이번 원천 수집에서 기존 검수 경고가 해결되었습니다.", sourceId, oldIssue.path("id").asText());
+                newlyResolved = true;
+            }
+            boolean conflict = java.util.stream.StreamSupport.stream(corrections.spliterator(), false).anyMatch(p -> "CONFLICT".equals(p.path("status").asText()));
+            boolean history = !previous.isMissingNode() && (!"CLEAN".equals(previous.path("quality").asText("CLEAN")) || !previous.path("corrections").isEmpty());
+            boolean originalWarning = !UniquePlayDetailQuality.issues(source).isEmpty();
+            String quality = !issues.isEmpty() || conflict || (!available && history) ? "CORRECTION_PENDING" : (history || !corrections.isEmpty() || originalWarning ? "RESOLVED" : "CLEAN");
+            review.put("quality", quality);
+            if ("RESOLVED".equals(quality)) {
+                review.put("resolutionSource", manual ? "MANUAL" : previous.path("quality").asText().equals("RESOLVED") && !newlyResolved ? previous.path("resolutionSource").asText("SOURCE") : "SOURCE");
+                String resolvedAt = previous.path("resolvedAt").asText(null);
+                if (resolvedAt == null || newlyResolved || !previous.path("quality").asText().equals("RESOLVED")) {
+                    resolvedAt = manual ? java.util.stream.StreamSupport.stream(corrections.spliterator(), false).map(p -> p.path("correctedAt").asText()).max(String::compareTo).orElse(candidate.path("capturedAt").asText()) : candidate.path("capturedAt").asText();
+                }
+                review.put("resolvedAt", resolvedAt);
+            } else { review.putNull("resolutionSource"); review.putNull("resolvedAt"); }
+        }
+        // A missing game must not silently discard an administrator's active correction.
+        if (base != null) for (JsonNode previous : base.path(META).path("games")) {
+            String id = previous.path("sourceGameId").asText();
+            if (present.contains(id) || previous.path("corrections").isEmpty()) continue;
+            LinkedHashMap<String, JsonNode> patches = new LinkedHashMap<>();
+            previous.path("corrections").forEach(patch -> patches.put(targetKey(patch), patch));
+            items.stream().filter(item -> ENTITY.equals(item.getEntityType()) && item.getAfterJson() != null)
+                .sorted(Comparator.comparing(UniquePlaySyncItem::getId, Comparator.nullsLast(Comparator.naturalOrder())))
+                .map(item -> mapper.readTree(item.getAfterJson())).filter(patch -> id.equals(patch.path("sourceGameId").asText())).forEach(patch -> patches.put(targetKey(patch), patch));
+            ObjectNode review = metadata.addObject(); review.put("sourceGameId", id); review.putNull("originalDetail");
+            review.putArray("issues"); ArrayNode corrections = review.putArray("corrections"), notifications = review.putArray("notifications");
+            boolean conflict = false;
+            for (JsonNode stored : patches.values()) {
+                ObjectNode patch = ((ObjectNode) stored).deepCopy();
+                if (!Set.of("RETIRED", "SOURCE_RESOLVED").contains(patch.path("status").asText())) {
+                    patch.put("status", "CONFLICT"); conflict = true;
+                    notify(notifications, "CORRECTION_CONFLICT", "보정한 경기의 원천 상세가 사라졌습니다. 수동 보정 해제를 명시적으로 확인하세요.", id, patch.path("id").asText());
+                }
+                corrections.add(patch);
+            }
+            review.put("quality", conflict ? "CORRECTION_PENDING" : "RESOLVED"); review.putNull("resolutionSource"); review.putNull("resolvedAt");
+        }
+        return result;
+    }
+
+    static JsonNode reviewGame(JsonNode snapshot, String sourceId) {
+        if (snapshot != null) for (JsonNode game : snapshot.path(META).path("games")) if (sourceId.equals(game.path("sourceGameId").asText())) return game;
+        return tools.jackson.databind.node.MissingNode.getInstance();
+    }
+
+    static ObjectNode sourceSnapshot(JsonNode published, ObjectMapper mapper) {
+        ObjectNode source = ((ObjectNode) published).deepCopy();
+        if (source.has("gameDetails")) {
+            ArrayNode details = source.putArray("gameDetails");
+            for (JsonNode detail : published.path("gameDetails")) {
+                JsonNode original = reviewGame(published, detail.path("sourceGameId").asText()).path("originalDetail");
+                details.add(original.isObject() ? original.deepCopy() : detail.deepCopy());
+            }
+        }
+        source.remove(META); source.remove("checksum");
+        return source;
+    }
+
+    static ObjectNode patch(JsonNode original, JsonNode effective, DetailChange change, String note, String actor, ObjectMapper mapper) {
+        if (change == null || change.section() == null || change.field() == null || change.teamName() == null || change.expectedValue() == null || change.value() == null) throw bad("Correction target, expectedValue and value are required (explicit null is allowed)");
+        Set<String> allowed = switch (change.section()) {
+            case "innings" -> Set.of("runs", "notPlayed");
+            case "totals" -> Set.of("hits", "errors", "walks"); // Final team score remains source-owned.
+            case "batters" -> BATTER_FIELDS;
+            case "pitchers" -> PITCHER_FIELDS;
+            default -> throw bad("Unsupported correction section");
+        };
+        if (!allowed.contains(change.field())) throw bad("This field cannot be corrected");
+        ObjectNode patch = mapper.createObjectNode();
+        patch.put("id", UUID.randomUUID().toString()); patch.put("sourceGameId", original.path("sourceGameId").asText());
+        patch.put("teamName", change.teamName()); patch.put("section", change.section());
+        if (change.rowKey() == null) patch.putNull("rowKey"); else patch.put("rowKey", change.rowKey());
+        if (change.inning() == null) patch.putNull("inning"); else patch.put("inning", change.inning());
+        patch.put("field", change.field());
+        JsonNode effectiveTarget = locate(effective, patch, true), sourceTarget = locate(original, patch, true);
+        if (!same(effectiveTarget.path(change.field()), change.expectedValue())) throw conflict("The correction field changed after preview");
+        patch.set("expectedValue", sourceTarget.path(change.field()).deepCopy()); patch.set("value", change.value().deepCopy());
+        if (Set.of("batters", "pitchers").contains(change.section())) {
+            JsonNode row = locateRow(original, patch);
+            patch.set("playerName", row.path("playerName")); patch.set("jerseyNumber", row.path("jerseyNumber"));
+        } else { patch.putNull("playerName"); patch.putNull("jerseyNumber"); }
+        patch.put("status", "APPLIED"); patch.put("note", note); patch.put("actor", actor); patch.put("correctedAt", OffsetDateTime.now(java.time.ZoneId.of("Asia/Seoul")).toString());
+        return patch;
+    }
+
+    static JsonNode locate(JsonNode detail, JsonNode patch, boolean required) {
+        JsonNode row = locateRow(detail, patch);
+        if (row == null) { if (required) throw conflict("The original game/team/player/inning identity no longer exists"); return null; }
+        if (Set.of("batters", "pitchers").contains(patch.path("section").asText())) {
+            if (patch.hasNonNull("playerName") && (!same(row.path("playerName"), patch.path("playerName")) || !same(row.path("jerseyNumber"), patch.path("jerseyNumber")))) {
+                if (required) throw conflict("The player row identity changed"); return null;
+            }
+            return row.path("stats");
+        }
+        return row;
+    }
+    private static JsonNode locateRow(JsonNode detail, JsonNode patch) {
+        if (detail == null || !"AVAILABLE".equals(detail.path("status").asText())) return null;
+        List<JsonNode> matchingTeams = new ArrayList<>();
+        for (JsonNode team : detail.path("teams")) if (UniquePlayGameDetailSupport.normalize(team.path("teamName").asText()).equals(UniquePlayGameDetailSupport.normalize(patch.path("teamName").asText()))) matchingTeams.add(team);
+        if (matchingTeams.size() != 1) return null;
+        JsonNode team = matchingTeams.getFirst(); String section = patch.path("section").asText();
+        if ("totals".equals(section)) return team.path("totals");
+        List<JsonNode> found = new ArrayList<>();
+        for (JsonNode row : team.path(section)) {
+            if ("innings".equals(section) ? patch.path("inning").isIntegralNumber() && row.path("inning").asInt() == patch.path("inning").asInt()
+                : patch.hasNonNull("rowKey") && row.path("rowKey").asText().equals(patch.path("rowKey").asText())) found.add(row);
+        }
+        return found.size() == 1 ? found.getFirst() : null;
+    }
+    static String targetKey(JsonNode patch) { return UniquePlayDetailQuality.id(patch.path("sourceGameId").asText(), UniquePlayGameDetailSupport.normalize(patch.path("teamName").asText()), patch.path("section").asText(), patch.path("rowKey").asText(""), patch.path("inning").asText(""), patch.path("field").asText()); }
+    static boolean same(JsonNode a, JsonNode b) { return a != null && b != null && (a.isNumber() && b.isNumber() ? a.decimalValue().compareTo(b.decimalValue()) == 0 : Objects.equals(a, b)); }
+    static void notify(ArrayNode array, String code, String message, String sourceGameId, String referenceId) {
+        ObjectNode value = array.addObject(); value.put("code", code); value.put("message", message); value.put("sourceGameId", sourceGameId); value.put("referenceId", referenceId);
+    }
+    static ResponseStatusException conflict(String message) { return new ResponseStatusException(HttpStatus.CONFLICT, message); }
+    static ResponseStatusException bad(String message) { return new ResponseStatusException(HttpStatus.BAD_REQUEST, message); }
+}
