--- /dev/null
+++ b/src/main/java/com/aubl/webpage/service/UniquePlayDetailQuality.java
@@ -0,0 +1,87 @@
+package com.aubl.webpage.service;
+
+import com.aubl.webpage.api.dto.OfficialGameDetailDtos.DetailIssue;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.ArrayList;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.Set;
+import tools.jackson.databind.JsonNode;
+
+/** Conservative cross-field warnings, never an inference from free-form plate appearance text. */
+final class UniquePlayDetailQuality {
+    private UniquePlayDetailQuality() {}
+    static final Set<String> SOFT_CODES = Set.of("DETAIL_LINE_SCORE", "DETAIL_BATTER_TOTAL", "DETAIL_BATTER_HITS_AB",
+        "DETAIL_TEAM_RBI", "DETAIL_TEAM_RBI_ZERO", "DETAIL_BATTER_RBI_MISSING", "DETAIL_PITCHER_EARNED_RUNS", "DETAIL_PITCHER_RUNS_TOTAL", "DETAIL_PITCHER_HITS_TOTAL");
+
+    static List<DetailIssue> issues(JsonNode detail) {
+        List<DetailIssue> result = new ArrayList<>();
+        if (detail == null || !"AVAILABLE".equals(detail.path("status").asText())) return result;
+        String gameId = detail.path("sourceGameId").asText();
+        for (JsonNode team : detail.path("teams")) {
