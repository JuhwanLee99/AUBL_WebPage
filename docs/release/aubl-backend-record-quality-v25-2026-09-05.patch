+        for (JsonNode row : rows) { Integer value = integer(row.path("stats").path(field)); if (value == null) return null; total += value; }
+        return total;
+    }
+    private static void add(List<DetailIssue> result, String code, String message, String game, String team, String field, String row, Integer observed, Integer expected) {
+        result.add(new DetailIssue(id(game, UniquePlayGameDetailSupport.normalize(team), field, row == null ? "" : row, code), code, message, game, team, field, row, observed, expected));
+    }
