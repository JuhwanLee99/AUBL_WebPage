+++ b/src/main/java/com/aubl/webpage/service/OfficialGameDetailService.java
@@ -0,0 +1,154 @@
+package com.aubl.webpage.service;
+
+import com.aubl.webpage.api.dto.OfficialGameDetailDtos.GameDetailResponse;
+import com.aubl.webpage.api.dto.OfficialGameDetailDtos.GameSummary;
+import com.aubl.webpage.api.dto.OfficialGameDetailDtos.PlayerGameRow;
+import com.aubl.webpage.api.dto.OfficialGameDetailDtos.PlayerOfficialGameLogsResponse;
+import com.aubl.webpage.domain.entity.Game;
+import com.aubl.webpage.domain.entity.Player;
+import com.aubl.webpage.domain.entity.Season;
+import com.aubl.webpage.domain.entity.Team;
+import com.aubl.webpage.domain.entity.TeamPlayer;
+import com.aubl.webpage.domain.entity.UniquePlaySyncRevision;
+import com.aubl.webpage.domain.repository.ExternalEntityMappingRepository;
+import com.aubl.webpage.domain.repository.GameRepository;
+import com.aubl.webpage.domain.repository.PlayerRepository;
+import com.aubl.webpage.domain.repository.SeasonRepository;
+import com.aubl.webpage.domain.repository.TeamPlayerRepository;
+import com.aubl.webpage.domain.repository.TeamRepository;
+import com.aubl.webpage.domain.repository.UniquePlaySyncRevisionRepository;
+import java.time.LocalDateTime;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Set;
+import java.util.stream.Collectors;
+import org.springframework.http.HttpStatus;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.server.ResponseStatusException;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.ObjectMapper;
+
+/** Read-only access to the immutable active official snapshot; never falls back to manual logs. */
+@Service
+@Transactional(readOnly = true)
+public class OfficialGameDetailService {
+    private static final String PROVIDER = "UNIQUE_PLAY";
+    private final ObjectMapper mapper;
+    private final GameRepository games;
+    private final SeasonRepository seasons;
+    private final UniquePlaySyncRevisionRepository revisions;
+    private final PlayerRepository players;
+    private final TeamPlayerRepository memberships;
+    private final TeamRepository teams;
+    private final ExternalEntityMappingRepository mappings;
+
+    public OfficialGameDetailService(ObjectMapper mapper, GameRepository games, SeasonRepository seasons,
+                                    UniquePlaySyncRevisionRepository revisions, PlayerRepository players,
+                                    TeamPlayerRepository memberships, TeamRepository teams,
+                                    ExternalEntityMappingRepository mappings) {
+        this.mapper = mapper; this.games = games; this.seasons = seasons; this.revisions = revisions;
+        this.players = players; this.memberships = memberships; this.teams = teams; this.mappings = mappings;
+    }
+
+    public GameDetailResponse gameDetails(String sourceGameId, Long seasonId) {
+        Game game = games.findBySourceProviderAndSourceGameId(PROVIDER, sourceGameId)
+            .orElseThrow(() -> missing("Official game not found"));
+        if (seasonId != null && !seasonId.equals(game.getSeason().getId())) throw missing("Official game not found in the requested season");
+        UniquePlaySyncRevision revision = revisions.findBySeasonYearAndActiveTrue(game.getSeason().getYear())
+            .filter(active -> active.getId().equals(game.getSyncRevision()))
+            .orElseThrow(() -> missing("Official game is not in the active revision"));
+        JsonNode snapshot = mapper.readTree(revision.getCandidateJson());
+        JsonNode summary = UniquePlayGameDetailSupport.index(snapshot.path("games")).get(sourceGameId);
+        if (summary == null) throw missing("Official game is not in the active snapshot");
+        JsonNode detail = UniquePlayGameDetailSupport.index(snapshot.path("gameDetails")).get(sourceGameId);
+        boolean reviewRequired = detail != null && "AVAILABLE".equals(detail.path("status").asText()) && !UniquePlayGameDetailSupport.matchesPublishedResult(game, summary);
+        return new GameDetailResponse(sourceGameId, game.getId(), game.getSeason().getId(), PROVIDER,
+            revision.getId(), revision.getCapturedAt(), publishedAt(revision),
+            reviewRequired ? "REVIEW_REQUIRED" : detail == null ? "NOT_COLLECTED" : detail.path("status").asText(), publicSummary(game, summary), reviewRequired ? null : detail);
+    }
+
+    public PlayerOfficialGameLogsResponse playerGameLogs(Long playerId, Long seasonId) {
+        Player player = players.findById(playerId).orElseThrow(() -> missing("Player not found"));
+        Season season = resolveSeason(seasonId);
+        UniquePlaySyncRevision revision = revisions.findBySeasonYearAndActiveTrue(season.getYear()).orElse(null);
+        if (revision == null) return response(playerId, season, null, "NO_ACTIVE_REVISION", List.of());
+        JsonNode snapshot = mapper.readTree(revision.getCandidateJson());
+        if (!snapshot.has("gameDetails")) return response(playerId, season, revision, "NOT_COLLECTED", List.of());
+        List<TeamPlayer> roster = memberships.findDistinctBySeasonId(season.getId());
+        Set<Long> playerTeamIds = roster.stream().filter(member -> Objects.equals(member.getPlayer().getId(), playerId))
+            .map(member -> member.getTeam().getId()).collect(Collectors.toSet());
+        if (playerTeamIds.isEmpty()) return response(playerId, season, revision, "IDENTITY_UNRESOLVED", List.of());
+        String playerName = UniquePlayGameDetailSupport.normalize(player.getPlayerName());
+        Map<String, JsonNode> summaries = UniquePlayGameDetailSupport.index(snapshot.path("games"));
+        Map<String, Long> backendIds = new HashMap<>();
+        Map<String, Game> publishedGames = new HashMap<>();
+        for (Game game : games.findBySeasonIdAndSourceProvider(season.getId(), PROVIDER)) {
+            if (revision.getId().equals(game.getSyncRevision())) { backendIds.put(game.getSourceGameId(), game.getId()); publishedGames.put(game.getSourceGameId(), game); }
+        }
+        Map<String, Long> teamIds = new HashMap<>();
+        Map<String, List<Team>> exactTeams = teams.findAll().stream().collect(Collectors.groupingBy(team -> teamMappingKey(team.getTeamName())));
+        List<PlayerGameRow> result = new ArrayList<>();
+        for (JsonNode detail : snapshot.path("gameDetails")) {
+            if (!"AVAILABLE".equals(detail.path("status").asText())) continue;
+            String sourceId = detail.path("sourceGameId").asText();
+            JsonNode game = summaries.get(sourceId);
+            if (game == null || !backendIds.containsKey(sourceId)) continue;
+            for (JsonNode team : detail.path("teams")) {
+                List<JsonNode> batting = namedRows(team.path("batters"), playerName);
+                List<JsonNode> pitching = namedRows(team.path("pitchers"), playerName);
+                if (batting.isEmpty() && pitching.isEmpty()) continue;
+                String teamName = teamMappingKey(team.path("teamName").asText());
+                Long teamId = teamIds.computeIfAbsent(teamName, name -> mappings.findByProviderAndEntityTypeAndExternalKey(PROVIDER, "TEAM", name)
+                    .map(mapping -> mapping.getLocalEntityId())
+                    .orElseGet(() -> exactTeams.getOrDefault(name, List.of()).size() == 1 ? exactTeams.get(name).getFirst().getId() : null));
+                if (teamId == null) return response(playerId, season, revision, "IDENTITY_UNRESOLVED", List.of());
+                if (!playerTeamIds.contains(teamId)) continue;
+                if (!UniquePlayGameDetailSupport.matchesPublishedResult(publishedGames.get(sourceId), game)) return response(playerId, season, revision, "REVIEW_REQUIRED", List.of());
+                Set<Long> sameNamePlayerIds = roster.stream().filter(member -> Objects.equals(member.getTeam().getId(), teamId)
+                        && playerName.equals(UniquePlayGameDetailSupport.normalize(member.getPlayer().getPlayerName())))
+                    .map(member -> member.getPlayer().getId()).collect(Collectors.toSet());
+                // Neither jersey guessing nor first-match selection may merge different people.
+                if (sameNamePlayerIds.size() != 1 || !sameNamePlayerIds.contains(playerId) || batting.size() > 1 || pitching.size() > 1) {
+                    return response(playerId, season, revision, "IDENTITY_UNRESOLVED", List.of());
+                }
+                GameSummary summary = publicSummary(publishedGames.get(sourceId), game);
+                result.add(new PlayerGameRow(sourceId, backendIds.get(sourceId), summary.playedAt(), summary.groupCode(),
+                    summary.venue(), summary.homeTeamName(), summary.awayTeamName(), summary.homeScore(), summary.awayScore(),
+                    team.path("teamName").asText(), batting, pitching));
+            }
+        }
+        result.sort(Comparator.comparing(PlayerGameRow::playedAt).reversed().thenComparing(PlayerGameRow::sourceGameId));
+        return response(playerId, season, revision, "AVAILABLE", result);
+    }
+
+    private List<JsonNode> namedRows(JsonNode rows, String playerName) {
+        List<JsonNode> result = new ArrayList<>();
+        for (JsonNode row : rows) if (playerName.equals(UniquePlayGameDetailSupport.normalize(row.path("playerName").asText()))) result.add(row);
+        return result;
+    }
+
+    private Season resolveSeason(Long id) {
+        if (id != null) return seasons.findById(id).orElseThrow(() -> missing("Season not found"));
+        return seasons.findAllByOrderByYearAsc().stream().max(Comparator.comparing(Season::getYear)).orElseThrow(() -> missing("Season not found"));
+    }
+
+    private PlayerOfficialGameLogsResponse response(Long playerId, Season season, UniquePlaySyncRevision revision, String status, List<PlayerGameRow> rows) {
+        return new PlayerOfficialGameLogsResponse(playerId, season.getId(), PROVIDER, revision == null ? null : revision.getId(),
+            revision == null ? null : revision.getCapturedAt(), revision == null ? null : publishedAt(revision), status, rows);
+    }
+
+    private GameSummary publicSummary(Game game, JsonNode source) {
+        String playedAt = game.getStartTime() != null ? game.getStartTime().atZone(java.time.ZoneId.of("Asia/Seoul")).toOffsetDateTime().toString()
+            : game.getGameDate() != null ? game.getGameDate().atStartOfDay(java.time.ZoneId.of("Asia/Seoul")).toOffsetDateTime().toString() : source.path("playedAt").asText();
+        return new GameSummary(playedAt, game.getGroupCode(), game.getVenue(), source.path("homeTeamName").asText(),
+            source.path("awayTeamName").asText(), game.getHomeScore(), game.getAwayScore(), UniquePlayGameDetailSupport.publicStatus(game.getStatus()));
+    }
+    private String teamMappingKey(String value) { return UniquePlayGameDetailSupport.normalize(value).replaceAll("\\s+", "").toLowerCase(java.util.Locale.ROOT); }
+    private LocalDateTime publishedAt(UniquePlaySyncRevision revision) { return revision.getActivatedAt() == null ? revision.getCreatedAt() : revision.getActivatedAt(); }
+    private ResponseStatusException missing(String message) { return new ResponseStatusException(HttpStatus.NOT_FOUND, message); }
+}
diff --git a/src/main/java/com/aubl/webpage/service/UniquePlayGameDetailSupport.java b/src/main/java/com/aubl/webpage/service/UniquePlayGameDetailSupport.java
new file mode 100644
index 0000000..6d9ff94
--- /dev/null
+++ b/src/main/java/com/aubl/webpage/service/UniquePlayGameDetailSupport.java
@@ -0,0 +1,217 @@
+package com.aubl.webpage.service;
+
+import com.aubl.webpage.domain.entity.UniquePlaySyncItem;
+import com.aubl.webpage.domain.entity.Game;
+import java.math.BigDecimal;
+import java.text.Normalizer;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.server.ResponseStatusException;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.ObjectMapper;
+import tools.jackson.databind.node.ObjectNode;
+
+/** Public boxscore snapshots only. No legacy game logs or season aggregates are written here. */
+final class UniquePlayGameDetailSupport {
+    private static final Set<String> DETAIL = Set.of("schemaVersion", "sourceGameId", "providerGameId", "status", "teams");
+    private static final Set<String> TEAM = Set.of("teamName", "innings", "totals", "batters", "pitchers");
+    private static final Set<String> BATTER = Set.of("rowKey", "playerName", "jerseyNumber", "battingOrder", "position", "stats", "plateAppearances");
+    private static final Set<String> PITCHER = Set.of("rowKey", "playerName", "jerseyNumber", "decision", "stats");
+    private static final Set<String> BATTING_STATS = Set.of("atBats", "hits", "rbi", "stolenBases", "runs", "battingAverage", "seasonBattingAverage");
+    private static final Set<String> PITCHING_STATS = Set.of("outs", "inningsPitched", "hitsAllowed", "runsAllowed", "earnedRuns", "walksAndHitByPitch", "strikeouts", "era");
+
+    private UniquePlayGameDetailSupport() {}
+
+    static void assertShape(JsonNode candidate) {
+        if (!candidate.has("gameDetails")) return; // Re-activation of pre-boxscore revisions remains supported.
+        rejectPrivateText(candidate.path("gameDetails"));
+        array(candidate.path("gameDetails"), "gameDetails", 2000);
+        for (JsonNode detail : candidate.path("gameDetails")) {
+            keys(detail, DETAIL, "gameDetails[]");
+            array(detail.path("teams"), "gameDetails[].teams", 2);
+            for (JsonNode team : detail.path("teams")) {
+                keys(team, TEAM, "gameDetails[].teams[]");
+                keys(team.path("totals"), Set.of("runs", "hits", "errors", "walks"), "totals");
+                array(team.path("innings"), "innings", 30);
+                for (JsonNode inning : team.path("innings")) keys(inning, Set.of("inning", "runs", "notPlayed"), "innings[]");
+                array(team.path("batters"), "batters", 100);
+                array(team.path("pitchers"), "pitchers", 100);
+                for (JsonNode row : team.path("batters")) {
+                    keys(row, BATTER, "batters[]");
+                    keys(row.path("stats"), BATTING_STATS, "batter.stats");
+                    array(row.path("plateAppearances"), "plateAppearances", 100);
+                    for (JsonNode plate : row.path("plateAppearances")) keys(plate, Set.of("inning", "result"), "plateAppearances[]");
+                }
+                for (JsonNode row : team.path("pitchers")) {
+                    keys(row, PITCHER, "pitchers[]");
+                    keys(row.path("stats"), PITCHING_STATS, "pitcher.stats");
+                }
+            }
+        }
+    }
+
+    static List<Problem> validate(JsonNode candidate) {
+        List<Problem> errors = new ArrayList<>();
+        if (!candidate.has("gameDetails")) return errors;
+        Map<String, JsonNode> games = index(candidate.path("games"));
+        Set<String> seen = new HashSet<>();
+        Set<String> providerIds = new HashSet<>();
+        for (int i = 0; i < candidate.path("gameDetails").size(); i++) {
+            JsonNode detail = candidate.path("gameDetails").get(i);
+            String path = "$.gameDetails[" + i + "]";
+            String id = detail.path("sourceGameId").asText();
+            JsonNode game = games.get(id);
+            if (!id.matches("[A-Za-z0-9_-]{1,128}") || !seen.add(id) || game == null || !"COMPLETED".equals(game.path("status").asText())) {
+                error(errors, "DETAIL_GAME", "상세 기록은 중복 없이 종료 경기와 연결되어야 합니다.", path);
+            }
+            if (!detail.path("providerGameId").isTextual() || !detail.path("providerGameId").asText().matches("[0-9]{1,24}")
+                || !providerIds.add(detail.path("providerGameId").asText())) {
+                error(errors, "DETAIL_PROVIDER_ID", "UniquePlay 실제 경기 ID가 없거나 중복되었습니다.", path);
+            }
+            if (!detail.path("schemaVersion").isIntegralNumber() || detail.path("schemaVersion").asInt() != 1) {
+                error(errors, "DETAIL_SCHEMA", "지원하지 않는 경기 상세 스키마입니다.", path);
+            }
+            String status = detail.path("status").asText();
+            if (!Set.of("AVAILABLE", "NOT_PUBLISHED").contains(status)) error(errors, "DETAIL_STATUS", "상세 기록 상태가 올바르지 않습니다.", path);
+            if ("NOT_PUBLISHED".equals(status)) {
+                if (!detail.path("teams").isEmpty()) error(errors, "DETAIL_PARTIAL", "미게시 상세 기록에는 일부 선수 기록을 포함할 수 없습니다.", path);
+                continue;
+            }
+            if (detail.path("teams").size() != 2) error(errors, "DETAIL_TEAM_COUNT", "양 팀의 상세 기록이 모두 필요합니다.", path);
+            Set<String> detailTeams = new HashSet<>();
+            for (JsonNode team : detail.path("teams")) {
+                String teamName = normalize(team.path("teamName").asText());
+                boolean home = game != null && teamName.equals(normalize(game.path("homeTeamName").asText()));
+                boolean away = game != null && teamName.equals(normalize(game.path("awayTeamName").asText()));
+                if (teamName.isBlank() || !detailTeams.add(teamName) || (!home && !away)) error(errors, "DETAIL_TEAM", "상세 기록의 팀이 경기 양 팀과 일치하지 않습니다.", path);
+                text(team.path("teamName"), 160, false, errors, path);
+                for (String key : Set.of("runs", "hits", "errors", "walks")) number(team.path("totals").path(key), true, 999, errors, path);
+                if (game != null && (home || away) && !sameNumber(team.path("totals").path("runs"), game.path(home ? "homeScore" : "awayScore"))) {
+                    error(errors, "DETAIL_SCORE", "상세 기록 득점 합계와 경기 결과가 일치하지 않습니다.", path);
+                }
+                Set<Integer> innings = new HashSet<>();
+                int runs = 0;
+                boolean hasRuns = false;
+                boolean allInningsKnown = true;
+                for (JsonNode inning : team.path("innings")) {
+                    int inningNumber = inning.path("inning").asInt();
+                    if (!integer( inning.path("inning"), 1, 30) || !innings.add(inningNumber)) error(errors, "DETAIL_INNING", "이닝 번호가 올바르지 않거나 중복되었습니다.", path);
+                    number(inning.path("runs"), true, 999, errors, path);
+                    if (!inning.path("notPlayed").isBoolean() || (inning.path("notPlayed").asBoolean() && !inning.path("runs").isNull())) error(errors, "DETAIL_INNING", "미진행 이닝은 득점이 비어 있어야 합니다.", path);
+                    if (inning.path("runs").isNumber()) { runs += inning.path("runs").asInt(); hasRuns = true; }
+                    else if (!inning.path("notPlayed").asBoolean()) allInningsKnown = false;
+                }
+                if (innings.isEmpty() || !hasRuns || (allInningsKnown && runs != team.path("totals").path("runs").asInt(-1))) error(errors, "DETAIL_LINE_SCORE", "이닝별 점수와 득점 합계가 일치하지 않습니다.", path);
+                for (String kind : List.of("batters", "pitchers")) {
+                    JsonNode rows = team.path(kind);
+                    if (rows.isEmpty()) error(errors, "DETAIL_PLAYER_ROWS", "양 팀의 타자·투수 기록이 모두 필요합니다.", path);
+                    Set<String> rowKeys = new HashSet<>();
+                    for (JsonNode row : rows) {
+                        if (!row.path("rowKey").isTextual() || !row.path("rowKey").asText().matches("[A-Za-z0-9_-]{1,128}") || !rowKeys.add(row.path("rowKey").asText())) error(errors, "DETAIL_ROW_ID", "선수 기록 행 ID가 없거나 중복되었습니다.", path);
+                        text(row.path("playerName"), 100, false, errors, path);
+                        if (!row.path("jerseyNumber").isNull() && (!row.path("jerseyNumber").isTextual() || !row.path("jerseyNumber").asText().matches("[0-9]{1,4}"))) error(errors, "DETAIL_JERSEY", "등번호 형식이 올바르지 않습니다.", path);
+                        if ("batters".equals(kind)) {
+                            if (!row.path("battingOrder").isNull() && !integer(row.path("battingOrder"), 1, 99)) error(errors, "DETAIL_ORDER", "타순이 올바르지 않습니다.", path);
+                            text(row.path("position"), 40, true, errors, path);
+                            for (String key : BATTING_STATS) number(row.path("stats").path(key), !key.endsWith("Average"), key.endsWith("Average") ? 1 : 999, errors, path);
+                            for (JsonNode plate : row.path("plateAppearances")) {
+                                if (!integer(plate.path("inning"), 1, 30)) error(errors, "DETAIL_PLATE", "타석의 이닝이 올바르지 않습니다.", path);
+                                text(plate.path("result"), 200, false, errors, path);
+                            }
+                        } else {
+                            text(row.path("decision"), 30, true, errors, path);
+                            for (String key : PITCHING_STATS) if (!"inningsPitched".equals(key)) number(row.path("stats").path(key), !"era".equals(key), 999, errors, path);
+                            JsonNode ip = row.path("stats").path("inningsPitched");
+                            JsonNode outs = row.path("stats").path("outs");
+                            if (ip.isNull() != outs.isNull()) error(errors, "DETAIL_OUTS", "투구 이닝과 아웃 수는 함께 존재해야 합니다.", path);
+                            if (!ip.isNull()) {
+                                if (!ip.isTextual() || !ip.asText().matches("[0-9]{1,2}(\\.[012])?")) error(errors, "DETAIL_OUTS", "투구 이닝 표기가 올바르지 않습니다.", path);
+                                else {
+                                    String[] parts = ip.asText().split("\\.");
+                                    int expected = Integer.parseInt(parts[0]) * 3 + (parts.length == 2 ? Integer.parseInt(parts[1]) : 0);
+                                    if (outs.asInt(-1) != expected) error(errors, "DETAIL_OUTS", "투구 이닝과 아웃 수가 일치하지 않습니다.", path);
+                                }
+                            }
+                        }
+                    }
+                    if ("batters".equals(kind) && !rows.isEmpty()) for (String totalKey : List.of("runs", "hits")) {
+                        int total = 0; boolean complete = true;
+                        for (JsonNode row : rows) { JsonNode value = row.path("stats").path(totalKey); if (!value.isNumber()) complete = false; else total += value.asInt(); }
+                        if (complete && team.path("totals").path(totalKey).isNumber() && total != team.path("totals").path(totalKey).asInt()) error(errors, "DETAIL_BATTER_TOTAL", "개별 타자 기록 합계와 팀 기록이 일치하지 않습니다.", path);
+                    }
+                }
+            }
+        }
+        for (JsonNode game : candidate.path("games")) if ("COMPLETED".equals(game.path("status").asText()) && !seen.contains(game.path("sourceGameId").asText())) error(errors, "DETAIL_COVERAGE", "종료 경기의 상세 수집 결과가 누락되었습니다.", "$.gameDetails");
+        return errors;
+    }
+
+    static JsonNode resolvedCandidate(JsonNode candidate, List<UniquePlaySyncItem> items, ObjectMapper mapper) {
+        if (!candidate.has("gameDetails")) return candidate;
+        Map<String, JsonNode> retained = new HashMap<>();
+        for (UniquePlaySyncItem item : items) if ("GAME_RECORD".equals(item.getEntityType()) && "KEEP_AUBL".equals(item.getResolution())) {
+            if (item.getBeforeJson() == null) throw new ResponseStatusException(HttpStatus.CONFLICT, "No prior official detail exists to retain");
+            retained.put(item.getSourceKey(), mapper.readTree(item.getBeforeJson()));
+        }
+        if (retained.isEmpty()) return candidate;
+        ObjectNode effective = ((ObjectNode) candidate).deepCopy();
+        var rows = effective.putArray("gameDetails");
+        for (JsonNode row : candidate.path("gameDetails")) rows.add(retained.getOrDefault(row.path("sourceGameId").asText(), row));
+        return effective;
+    }
+
+    static Map<String, JsonNode> index(JsonNode rows) {
+        Map<String, JsonNode> values = new HashMap<>();
+        for (JsonNode row : rows) values.put(row.path("sourceGameId").asText(), row);
+        return values;
+    }
+
+    static String normalize(String value) { return Normalizer.normalize(value == null ? "" : value, Normalizer.Form.NFKC).replaceAll("\\s+", " ").trim(); }
+    static boolean matchesPublishedResult(Game game, JsonNode row) {
+        return java.util.Objects.equals(game.getHomeScore(), nullableInteger(row.path("homeScore")))
+            && java.util.Objects.equals(game.getAwayScore(), nullableInteger(row.path("awayScore")))
+            && publicStatus(game.getStatus()).equals(publicStatus(row.path("status").asText()));
+    }
+    static String publicStatus(String status) {
+        if (status == null || status.isBlank()) return "UNKNOWN";
+        return switch (status.toUpperCase(java.util.Locale.ROOT)) {
+            case "FINISHED" -> "COMPLETED";
+            case "LIVE" -> "IN_PROGRESS";
+            case "CANCELLED" -> "CANCELED";
+            default -> status.toUpperCase(java.util.Locale.ROOT);
+        };
+    }
+    private static Integer nullableInteger(JsonNode node) { return node.isNumber() ? node.asInt() : null; }
+    private static void keys(JsonNode node, Set<String> expected, String path) {
+        if (!node.isObject() || node.size() != expected.size()) throw shape(path);
+        node.propertyNames().forEach(key -> { if (!expected.contains(key)) throw shape(path); });
+    }
+    private static void array(JsonNode node, String path, int max) { if (!node.isArray() || node.size() > max) throw shape(path); }
+    private static ResponseStatusException shape(String path) { return new ResponseStatusException(HttpStatus.UNPROCESSABLE_ENTITY, "Invalid public game detail shape at " + path); }
+    private static void rejectPrivateText(JsonNode node) {
+        if (node.isTextual() && (node.asText().matches("(?s).*[<>@\\p{Cntrl}].*") || node.asText().matches(".*0[0-9]{1,2}[- ]?[0-9]{3,4}[- ]?[0-9]{4}.*"))) throw shape("public text");
+        if (node.isObject()) node.properties().forEach(field -> {
+            // Numeric provider ids and hashed row keys are identifiers, not contact information.
+            if (!Set.of("sourceGameId", "providerGameId", "rowKey").contains(field.getKey())) rejectPrivateText(field.getValue());
+        });
+        else if (node.isArray()) node.forEach(UniquePlayGameDetailSupport::rejectPrivateText);
+    }
+    private static boolean integer(JsonNode node, int min, int max) { return node.isIntegralNumber() && node.canConvertToInt() && node.asInt() >= min && node.asInt() <= max; }
+    private static boolean sameNumber(JsonNode left, JsonNode right) { return left.isNumber() && right.isNumber() && left.decimalValue().compareTo(right.decimalValue()) == 0; }
+    private static void number(JsonNode node, boolean integer, double max, List<Problem> errors, String path) {
+        if (node.isNull()) return;
+        if (!node.isNumber() || (integer && !node.isIntegralNumber()) || node.decimalValue().compareTo(BigDecimal.ZERO) < 0 || node.decimalValue().compareTo(BigDecimal.valueOf(max)) > 0) error(errors, "DETAIL_STAT_RANGE", "상세 기록 수치 범위 또는 형식이 올바르지 않습니다.", path);
+    }
+    private static void text(JsonNode node, int max, boolean nullable, List<Problem> errors, String path) {
+        if (nullable && node.isNull()) return;
+        String value = node.asText();
+        if (!node.isTextual() || value.isBlank() || value.length() > max || value.matches("(?s).*[<>@\\p{Cntrl}].*") || value.matches(".*0[0-9]{1,2}[- ]?[0-9]{3,4}[- ]?[0-9]{4}.*")) error(errors, "DETAIL_PUBLIC_TEXT", "허용된 공개 기록 텍스트가 아닙니다.", path);
+    }
+    private static void error(List<Problem> errors, String code, String message, String path) { errors.add(new Problem(code, message, path)); }
+    record Problem(String code, String message, String path) {}
+}
