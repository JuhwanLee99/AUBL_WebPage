+class UniquePlayGameDetailPublicationTest {
+    private final UniquePlaySyncRunRepository runs = mock(UniquePlaySyncRunRepository.class);
+    private final UniquePlaySyncItemRepository items = mock(UniquePlaySyncItemRepository.class);
+    private final UniquePlaySyncRevisionRepository revisions = mock(UniquePlaySyncRevisionRepository.class);
+    private final ExternalEntityMappingRepository mappings = mock(ExternalEntityMappingRepository.class);
+    private final SeasonRepository seasons = mock(SeasonRepository.class);
+    private final GameRepository games = mock(GameRepository.class);
+    private final UniquePlayPublisher publisher = mock(UniquePlayPublisher.class);
+    private final AtomicReference<UniquePlaySyncRevision> saved = new AtomicReference<>();
+    private final List<UniquePlaySyncItem> decisions = new ArrayList<>();
+    private UniquePlaySyncService service;
+    private UniquePlaySyncRun run;
+    private ObjectNode candidate;
+
+    @BeforeEach void setup() {
+        service = new UniquePlaySyncService(OfficialGameDetailFixture.MAPPER, runs, items, revisions, mappings,
+            mock(TeamRepository.class), mock(TeamPlayerRepository.class), seasons, games,
+            mock(BatterStatsRepository.class), mock(PitcherStatsRepository.class), publisher, new ImmediateTransactionManager(), "", "", "57", 2026);
+        candidate = OfficialGameDetailFixture.candidate();
+        run = new UniquePlaySyncRun(); run.setId("run-details"); run.setSeasonYear(2026); run.setLeagueId("57"); run.setBaseRevision("NONE"); run.setStatus("READY_TO_PUBLISH");
+        var season = new Season(); season.setId(10L); season.setYear(2026);
+        when(seasons.findByYear(2026)).thenReturn(Optional.of(season));
+        when(runs.findById(run.getId())).thenReturn(Optional.of(run));
+        when(runs.save(any())).thenAnswer(call -> call.getArgument(0));
+        when(items.findByRunId(run.getId())).thenReturn(decisions);
+        when(revisions.save(any())).thenAnswer(call -> { UniquePlaySyncRevision revision = call.getArgument(0); saved.set(revision); return revision; });
+        refreshCandidate();
+    }
+
+    @Test void reviewedSnapshotHasOwnVerifiedChecksumAndLeavesRawPreviewUntouched() {
+        var prior = OfficialGameDetailFixture.detail(candidate).deepCopy();
+        OfficialGameDetailFixture.detail(candidate).put("status", "NOT_PUBLISHED").putArray("teams");
+        var decision = new UniquePlaySyncItem(); decision.setEntityType("GAME_RECORD"); decision.setSourceKey("up-game-1"); decision.setResolution("KEEP_AUBL"); decision.setBeforeJson(prior.toString()); decisions.add(decision);
+        refreshCandidate(); String rawChecksum = run.getChecksum();
+        service.publish(run.getId(), new PublishRequest(rawChecksum, "NONE"), "admin");
+        assertNotEquals(rawChecksum, saved.get().getChecksum());
+        var published = OfficialGameDetailFixture.MAPPER.readTree(saved.get().getCandidateJson());
+        assertEquals(saved.get().getChecksum(), ReflectionTestUtils.invokeMethod(service, "candidateChecksum", published));
+        assertEquals("AVAILABLE", published.path("gameDetails").get(0).path("status").asText());
+        assertEquals(rawChecksum, run.getChecksum());
+        assertEquals("NOT_PUBLISHED", OfficialGameDetailFixture.MAPPER.readTree(run.getCandidateJson()).path("gameDetails").get(0).path("status").asText());
+        verifyNoInteractions(games, publisher); verify(mappings, never()).save(any()); verify(mappings, never()).delete(any());
+    }
+
+    @Test void repeatedSameSnapshotReusesRevisionWithoutWritingGameLogs() {
+        service.publish(run.getId(), new PublishRequest(run.getChecksum(), "NONE"), "admin");
+        var first = saved.get(); run.setStatus("READY_TO_PUBLISH");
+        when(revisions.findBySeasonYearAndChecksum(2026, first.getChecksum())).thenReturn(Optional.of(first));
+        service.publish(run.getId(), new PublishRequest(run.getChecksum(), "NONE"), "admin");
+        verify(revisions, times(1)).save(any()); verifyNoInteractions(games, publisher);
+    }
+
+    @Test void retainedDetailCannotPublishAgainstCorrectedScore() {
+        var prior = OfficialGameDetailFixture.detail(candidate).deepCopy();
+        ((ObjectNode) candidate.path("games").get(0)).put("homeScore", 2);
+        var detail = OfficialGameDetailFixture.detail(candidate); detail.put("status", "NOT_PUBLISHED"); detail.putArray("teams");
+        var decision = new UniquePlaySyncItem(); decision.setEntityType("GAME_RECORD"); decision.setSourceKey("up-game-1"); decision.setResolution("KEEP_AUBL"); decision.setBeforeJson(prior.toString()); decisions.add(decision);
+        refreshCandidate();
+        assertThrows(ResponseStatusException.class, () -> service.publish(run.getId(), new PublishRequest(run.getChecksum(), "NONE"), "admin"));
+        verify(revisions, never()).save(any()); verifyNoInteractions(games, publisher);
+    }
+
+    @Test void originalPreviewChecksumIsStillRequiredAfterReview() {
+        assertThrows(ResponseStatusException.class, () -> service.publish(run.getId(), new PublishRequest("bad-checksum", "NONE"), "admin"));
+        verify(revisions, never()).save(any());
+    }
+
+    @Test void gameRecordDiffDetectsNewUnchangedAndDisappearingDetails() {
+        List<UniquePlaySyncItem> diff = new ArrayList<>();
+        when(items.save(any())).thenAnswer(call -> { UniquePlaySyncItem item = call.getArgument(0); diff.add(item); return item; });
+        ReflectionTestUtils.invokeMethod(service, "generateDiff", run, candidate);
+        assertEquals("CREATE", diff.stream().filter(item -> "GAME_RECORD".equals(item.getEntityType())).findFirst().orElseThrow().getAction());
+        var base = new UniquePlaySyncRevision(); base.setId("base"); base.setCandidateJson(candidate.toString());
+        run.setBaseRevision("base"); when(revisions.findById("base")).thenReturn(Optional.of(base)); diff.clear();
+        ReflectionTestUtils.invokeMethod(service, "generateDiff", run, candidate);
+        assertEquals("UNCHANGED", diff.stream().filter(item -> "GAME_RECORD".equals(item.getEntityType())).findFirst().orElseThrow().getAction());
+        OfficialGameDetailFixture.detail(candidate).put("status", "NOT_PUBLISHED").putArray("teams"); diff.clear();
+        ReflectionTestUtils.invokeMethod(service, "generateDiff", run, candidate);
+        var item = diff.stream().filter(row -> "GAME_RECORD".equals(row.getEntityType())).findFirst().orElseThrow();
+        assertEquals("CONFLICT", item.getAction()); assertTrue(item.isBlocking()); assertTrue(item.getLabel().contains("홈팀"));
+    }
+
+    @Test void validationRejectsStaleRetainedDetailBeforePublish() {
+        var prior = OfficialGameDetailFixture.detail(candidate).deepCopy();
+        ((ObjectNode) candidate.path("games").get(0)).put("homeScore", 2);
+        OfficialGameDetailFixture.detail(candidate).put("status", "NOT_PUBLISHED").putArray("teams");
+        var decision = new UniquePlaySyncItem(); decision.setEntityType("GAME_RECORD"); decision.setSourceKey("up-game-1"); decision.setResolution("KEEP_AUBL"); decision.setBeforeJson(prior.toString()); decisions.add(decision);
+        refreshCandidate();
+        service.validate(run.getId());
+        assertEquals("VALIDATION_FAILED", run.getStatus()); assertTrue(run.getValidationJson().contains("DETAIL_SCORE"));
+    }
+
+    @Test void olderWorkerCannotSilentlyRemoveAllPublishedGameDetails() {
+        var base = new UniquePlaySyncRevision(); base.setId("base"); base.setCandidateJson(candidate.toString());
+        run.setBaseRevision("base"); when(revisions.findById("base")).thenReturn(Optional.of(base));
+        when(revisions.findBySeasonYearAndActiveTrue(2026)).thenReturn(Optional.of(base));
+        candidate.remove("gameDetails"); refreshCandidate();
+        service.validate(run.getId());
+        assertEquals("VALIDATION_FAILED", run.getStatus()); assertTrue(run.getValidationJson().contains("DETAIL_SCHEMA_DOWNGRADE"));
+        run.setStatus("READY_TO_PUBLISH");
+        assertThrows(ResponseStatusException.class, () -> service.publish(run.getId(), new PublishRequest(run.getChecksum(), "base"), "admin"));
+        verify(revisions, never()).save(any());
+    }
+
+    @Test void legacyCandidateRemainsPublishableBeforeAnyDetailRevision() {
+        candidate.remove("gameDetails"); refreshCandidate();
+        service.publish(run.getId(), new PublishRequest(run.getChecksum(), "NONE"), "admin");
+        assertFalse(OfficialGameDetailFixture.MAPPER.readTree(saved.get().getCandidateJson()).has("gameDetails"));
+    }
+
+    @Test void retainedAublResultConflictIsBlockedUntilSourceIsChosen() {
+        Game local = new Game(); local.setId(50L); local.setHomeScore(2); local.setAwayScore(0); local.setStatus("COMPLETED");
+        when(games.findById(50L)).thenReturn(Optional.of(local));
+        var override = new ExternalEntityMapping(); override.setLocalEntityId(50L);
+        when(mappings.findByProviderAndEntityTypeAndExternalKey("UNIQUE_PLAY", "OVERRIDE_GAME", "up-game-1")).thenReturn(Optional.of(override));
+        var decision = new UniquePlaySyncItem(); decision.setEntityType("GAME"); decision.setSourceKey("up-game-1"); decision.setLocalEntityId(50L); decision.setResolution("KEEP_AUBL"); decisions.add(decision);
+        service.validate(run.getId());
+        assertEquals("VALIDATION_FAILED", run.getStatus()); assertTrue(run.getValidationJson().contains("DETAIL_GAME_OVERRIDE"));
+        run.setStatus("READY_TO_PUBLISH");
+        assertThrows(ResponseStatusException.class, () -> service.publish(run.getId(), new PublishRequest(run.getChecksum(), "NONE"), "admin"));
+        verify(revisions, never()).save(any());
+        decision.setResolution("USE_SOURCE"); service.validate(run.getId());
+        assertEquals("READY_TO_PUBLISH", run.getStatus());
+        service.publish(run.getId(), new PublishRequest(run.getChecksum(), "NONE"), "admin");
+        assertNotNull(saved.get()); verify(mappings).delete(override);
+    }
+
+    @Test void metadataOnlyAublOverrideDoesNotBlockOfficialDetail() {
+        Game local = new Game(); local.setId(50L); local.setHomeScore(1); local.setAwayScore(0); local.setStatus("COMPLETED"); local.setVenue("운영자 변경 구장");
+        when(games.findById(50L)).thenReturn(Optional.of(local));
+        var decision = new UniquePlaySyncItem(); decision.setEntityType("GAME"); decision.setSourceKey("up-game-1"); decision.setLocalEntityId(50L); decision.setResolution("KEEP_AUBL"); decisions.add(decision);
+        service.validate(run.getId());
+        assertEquals("READY_TO_PUBLISH", run.getStatus());
+    }
+
+    private void refreshCandidate() { String checksum = ReflectionTestUtils.invokeMethod(service, "candidateChecksum", candidate); candidate.put("checksum", checksum); run.setChecksum(checksum); run.setCandidateJson(candidate.toString()); }
+}
