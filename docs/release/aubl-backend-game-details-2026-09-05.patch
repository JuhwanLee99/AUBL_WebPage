+package com.aubl.webpage.api.dto;
+
+import java.time.LocalDateTime;
+import java.util.List;
+import tools.jackson.databind.JsonNode;
+
+public final class OfficialGameDetailDtos {
+    private OfficialGameDetailDtos() {}
+
+    public record GameSummary(String playedAt, String groupCode, String venue, String homeTeamName,
+                              String awayTeamName, Integer homeScore, Integer awayScore, String status) {}
+
+    public record GameDetailResponse(String sourceGameId, Long backendGameId, Long seasonId, String provider,
+                                     String syncRevision, LocalDateTime capturedAt, LocalDateTime publishedAt,
+                                     String status, GameSummary game, JsonNode detail) {}
+
+    public record PlayerGameRow(String sourceGameId, Long backendGameId, String playedAt, String groupCode,
+                                String venue, String homeTeamName, String awayTeamName, Integer homeScore,
+                                Integer awayScore, String teamName, List<JsonNode> batters, List<JsonNode> pitchers) {}
+
+    public record PlayerOfficialGameLogsResponse(Long playerId, Long seasonId, String provider, String syncRevision,
+                                                LocalDateTime capturedAt, LocalDateTime publishedAt, String status,
+                                                List<PlayerGameRow> games) {}
+}
diff --git a/src/main/java/com/aubl/webpage/service/OfficialGameDetailService.java b/src/main/java/com/aubl/webpage/service/OfficialGameDetailService.java
new file mode 100644
index 0000000..c230bce
