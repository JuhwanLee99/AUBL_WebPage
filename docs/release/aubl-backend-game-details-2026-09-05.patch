+package com.aubl.webpage.api;
+
+import com.aubl.webpage.api.dto.OfficialGameDetailDtos.GameDetailResponse;
+import com.aubl.webpage.api.dto.OfficialGameDetailDtos.PlayerOfficialGameLogsResponse;
+import com.aubl.webpage.service.OfficialGameDetailService;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.RestController;
+
+@RestController
+public class OfficialGameDetailController {
+    private final OfficialGameDetailService service;
+    public OfficialGameDetailController(OfficialGameDetailService service) { this.service = service; }
+
+    @GetMapping("/api/games/source/{sourceGameId}/details")
+    public GameDetailResponse details(@PathVariable String sourceGameId, @RequestParam(required = false) Long seasonId) {
+        return service.gameDetails(sourceGameId, seasonId);
+    }
+
+    @GetMapping("/api/players/{playerId}/official-game-logs")
+    public PlayerOfficialGameLogsResponse playerLogs(@PathVariable Long playerId, @RequestParam(required = false) Long seasonId) {
+        return service.playerGameLogs(playerId, seasonId);
+    }
+}
