diff --git a/src/test/java/com/aubl/webpage/api/UniquePlaySyncProblemDetailsTest.java b/src/test/java/com/aubl/webpage/api/UniquePlaySyncProblemDetailsTest.java
--- /dev/null
+++ b/src/test/java/com/aubl/webpage/api/UniquePlaySyncProblemDetailsTest.java
@@ -0,0 +1,24 @@
+package com.aubl.webpage.api;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ProblemDetail;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.server.ResponseStatusException;
+
+class UniquePlaySyncProblemDetailsTest {
+
+    @Test
+    void exposesSafeConflictReasonToTheAdminClient() {
+        UniquePlaySyncProblemDetails handler = new UniquePlaySyncProblemDetails();
+
+        ResponseEntity<ProblemDetail> response = handler.handleResponseStatus(
+            new ResponseStatusException(HttpStatus.CONFLICT, "Active revision changed before activation")
+        );
+
+        assertEquals(HttpStatus.CONFLICT, response.getStatusCode());
+        assertEquals("Active revision changed before activation", response.getBody().getDetail());
+    }
+}
